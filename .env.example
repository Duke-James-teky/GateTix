APP_NAME=GateTix
ENVIRONMENT=development

# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/gatetix
TEST_DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/gatetix_test

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# How long a reservation holds tickets
RESERVATION_HOLD_MINUTES=10
